{
    "openapi": "3.0.0",
    "info": {
        "title": "CaribeTour API",
        "description": "Salidas que el calendario de un tour consulta al cambiar de mes.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/products/{id}/itineraries": {
            "get": {
                "summary": "Salidas con plazas de un producto público",
                "operationId": "56ef83b65803b6b90483a440e44d1a76",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "month",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "year",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Salidas del mes, o todas si no se indica mes y año"
                    },
                    "404": {
                        "description": "El producto no es público"
                    }
                }
            }
        }
    }
}